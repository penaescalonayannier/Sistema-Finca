# Copie este archivo fuera del repositorio (por ejemplo, ~/.config/sistema-finca/peers.env)
# y protéjalo: chmod 600 ~/.config/sistema-finca/peers.env
# Las conexiones PostgreSQL deben usar ~/.pgpass o un certificado; no ponga claves aquí.

SYNC_DATABASE_URL='postgresql://postgres@localhost:5432/store'
SYNC_BATCH_SIZE=1000
REMOTE_SYNC_DIR='$HOME/sistema-finca'
REMOTE_SYNC_CONFIG='$HOME/.config/sistema-finca/peers.env'

# Identificador inmutable de esta instalación; genere uno con: uuidgen
SYNC_NODE_ID='REEMPLAZAR-CON-UUID-LOCAL'

# Cada alias debe existir en ~/.ssh/config y usar autenticación por llave.
declare -A PEER_IDS=(
  [rrhh]='REEMPLAZAR-UUID-RRHH'
  [contabilidad]='REEMPLAZAR-UUID-CONTABILIDAD'
  [central]='REEMPLAZAR-UUID-CENTRAL'
)
declare -A PEER_SSH=(
  [rrhh]='finca-rrhh'
  [contabilidad]='finca-contabilidad'
  [central]='finca-central'
)

# En cada PC, liste solamente los otros dos nodos.
SYNC_PEERS=(rrhh contabilidad)
